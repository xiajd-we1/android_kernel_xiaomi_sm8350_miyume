diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index d0ddc7c9..2ac8204e 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -124,6 +124,13 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
         goto skip_umount_task;
     }
 
+#ifdef CONFIG_KSU_SUSFS
+    /* SUSFS mode: do NOT touch the mount namespace of a freshly forked app.
+     * try_umount() here races with the app's own mount-ns setup and leaves
+     * it unable to attach (observed as "failed to attach" + stuck at
+     * bootanimation on 5.4). SUSFS only needs the TIF flag below. */
+    goto skip_umount_task;
+#else
     // umount the target mnt
     pr_info("handle umount for uid: %d, pid: %d\n", new_uid, current->pid);
 
@@ -137,6 +144,7 @@ int ksu_handle_umount(uid_t old_uid, uid_t new_uid)
     up_read(&mount_list_lock);
 
     revert_creds(saved);
+#endif
 
 skip_umount_task:
     // do susfs setuid when susfs enabled
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 7eb2de3f..b74eab98 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -21,6 +21,7 @@
 #include "manager/manager_identity.h"
 #include "infra/seccomp_cache.h"
 #include "supercall/supercall.h"
+#include "selinux/selinux.h"
 #ifdef CONFIG_KSU_TRACEPOINT_HOOK
 #include "hook/tp_marker.h"
 #endif
@@ -183,6 +184,11 @@ int ksu_handle_setresuid(uid_t ruid, uid_t euid, uid_t suid)
 #ifdef CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK
     return 0; // dummy hook here
 #else
+#ifdef CONFIG_KSU_SUSFS
+    /* First app spawn happens long after the SELinux policy is loaded, so
+     * this is the earliest safe point to populate cached_zygote_sid. */
+    cache_sid_if_needed();
+#endif
     // we rely on the fact that zygote always call setresuid(3) with same uids
     return ksu_handle_setuid(ruid, ksu_get_uid_t(current_uid()));
 #endif
diff --git a/kernel/include/klog.h b/kernel/include/klog.h
index 025475e7..0e9c0c0a 100644
--- a/kernel/include/klog.h
+++ b/kernel/include/klog.h
@@ -13,9 +13,33 @@
 
 #include <linux/printk.h>
 
-#ifdef pr_fmt
+/*
+ * Silence every BakaSU/KernelSU log line so the "KernelSU" string never
+ * reaches dmesg / /dev/kmsg. Detectors read the kernel log buffer to
+ * fingerprint the root implementation; keeping the arguments referenced
+ * (via no_printk) avoids unused-variable warnings while emitting
+ * nothing at runtime.
+ */
 #undef pr_fmt
-#define pr_fmt(fmt) "KernelSU: " fmt
-#endif
+#define pr_fmt(fmt) fmt
+
+#undef pr_emerg
+#undef pr_alert
+#undef pr_crit
+#undef pr_err
+#undef pr_warn
+#undef pr_notice
+#undef pr_info
+#undef pr_debug
+#undef pr_cont
+#define pr_emerg(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_alert(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_crit(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_err(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_warn(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_notice(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_info(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_debug(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
+#define pr_cont(fmt, ...) no_printk(fmt, ##__VA_ARGS__)
 
 #endif
diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
index bf9ba1f6..f3b287e3 100644
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -190,6 +190,27 @@ void cache_sid(void)
 #endif
 }
 
+/*
+ * Lazy SID cache refresh. cache_sid() in ksu_init() runs before the
+ * SELinux policy is fully loaded on some 5.4 non-GKI trees, leaving
+ * cached_zygote_sid == 0 and making is_zygote() always false. The first
+ * app spawn is a safe, late-enough point to populate it.
+ */
+void cache_sid_if_needed(void)
+{
+	if (likely(cached_zygote_sid != 0))
+		return;
+	cache_sid();
+}
+
+
+/*
+ * Lazy SID cache refresh. Called from ksu_handle_setresuid() on the
+ * first app spawn, which is guaranteed to run after the SELinux policy
+ * is loaded (unlike cache_sid() during ksu_init()).
+ */
+
+
 #if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
 static inline bool is_sid_match_tsec(const struct task_security_struct *tsec, u32 cached_sid,
                                      const char *fallback_context)
